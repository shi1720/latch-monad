{
  "name": "latch",
  "version": "1.0.0",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test test/*.test.mjs test/*.test.ts",
    "compile": "node scripts/compile.mjs",
    "deploy": "node scripts/deploy.mjs",
    "test:browser": "playwright test",
    "test:hosted": "PLAYWRIGHT_BASE_URL=https://latch-agent-receipts.web.app playwright test",
    "deploy:firebase": "bash scripts/deploy-firebase.sh",
    "start:quotes": "node server/index.mjs",
    "test:quotes": "node --test test/server.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "",
  "dependencies": {
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.57.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ganache": "^7.9.2",
    "solc": "^0.8.37",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "type": "module",
  "private": true
